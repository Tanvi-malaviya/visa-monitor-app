{
  "manifest_version": 3,
  "name": "US Visa Portal Auto-Fill Assistant",
  "version": "1.1",
  "description": "Automatically auto-fills credentials, signs in, and clicks login every 5s on official usvisascheduling.com and atlasauth portals.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://atlasauth.b2clogin.com/*",
    "https://www.usvisascheduling.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://atlasauth.b2clogin.com/*",
        "https://www.usvisascheduling.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
